# Loaded by `npm run dev` only. Overrides .env in development mode.
#
# Your local API — the one nodemon runs from helpdesk-server. Point the browser
# here while developing, otherwise every click goes to the DEPLOYED API, which
# only has the routes that were present the last time it was deployed. That is
# what produced "Not found: POST /api/tickets/<id>/resolve" while the same
# request answered correctly against localhost.
VITE_API_URL=http://localhost:5000

# Clerk publishable key for your DEVELOPMENT instance (pk_test_…), from
# https://dashboard.clerk.com → API keys. Public by design — Vite inlines it into
# the bundle. The matching sk_test_… goes in helpdesk-server/.env, never here.
#
# Empty is a valid state: customer sign-in at /login and /signup reports itself as
# unconfigured and staff sign-in at /admin/login carries on working.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Z2FtZS1zYWxtb24tNTQ2OS5jbGVyay5hY2NvdW50cy5kZXYk
