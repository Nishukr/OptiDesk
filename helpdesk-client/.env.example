# helpdesk-client/.env.example — copy to ".env.local" for personal overrides, or
# edit .env.development / .env.production directly. Nothing here is secret: Vite
# inlines every VITE_* value into the public bundle, so a browser can read all of
# it. Never put a password, API secret or webhook secret in a VITE_* variable.
#
# Which file wins:
#   npm run dev    → .env  +  .env.development  (+ .env.local)
#   npm run build  → .env  +  .env.production   (+ .env.local)
# Mode-specific values therefore live in the two mode files, NOT in .env — one
# variable set in both places has no obvious winner.

# ---- where the API lives ----
# Must match the server's PORT and its CORS_ORIGINS/CLIENT_URL.
#   .env.development → http://localhost:5000
#   .env.production  → https://your-api-host
VITE_API_URL=http://localhost:5000

# ---- customer sign-in (Clerk) ----
# Clerk hosts the customer sign-up/sign-in widgets at /login and /signup. Copy the
# PUBLISHABLE key from https://dashboard.clerk.com → API keys. Its secret partner
# (sk_…) belongs in helpdesk-server/.env as CLERK_SECRET_KEY and must never appear
# in this directory.
#
# Use the pk_test_… key from your Clerk development instance in .env.development
# and the pk_live_… key from the production instance in .env.production — they are
# different instances with different user lists.
#
# Leave it empty and the app still runs: /login and /signup explain that customer
# sign-in is not configured, and STAFF sign-in at /admin/login keeps working
# because it uses the custom JWT, not Clerk.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Z2FtZS1zYWxtb24tNTQ2OS5jbGVyay5hY2NvdW50cy5kZXYk
