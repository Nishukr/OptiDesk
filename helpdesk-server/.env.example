# Copy to ".env" and fill in.  (Windows: copy .env.example .env)
# Nothing in this file is secret — the real .env is git-ignored.

# ---- core ----
PORT=5000
MONGO_URI=mongodb+srv://nishukumarsahu9752_db_user:5tr5HrC4xG9tt6LH@cluster0.gozlg2v.mongodb.net/?appName=Cluster0
# Signs STAFF login tokens only (agents/admins). Customers are signed in by Clerk
# and their session tokens are verified with CLERK_SECRET_KEY instead.
JWT_SECRET=change-me-to-a-long-random-string

# ---- customer sign-in (Clerk) ----
# Customers sign up and sign in entirely inside Clerk's widgets; this API only
# verifies the session token they arrive with. Staff are NOT in Clerk — they keep
# the password form at /admin/login and the JWT_SECRET above.
#
# All three values come from https://dashboard.clerk.com:
#   API keys ....... CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY
#   Webhooks ....... CLERK_WEBHOOK_SECRET (create an endpoint first, see below)
#
# Leave the two API keys unset and /api/tickets, /api/chat and /api/me answer 503
# with an explanation; the staff side keeps working. That is the intended
# behaviour, not a bug — it means a half-configured server fails loudly on the
# customer routes only.
CLERK_PUBLISHABLE_KEY=pk_test_Z2FtZS1zYWxtb24tNTQ2OS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_mC7kun2638lp4rjIDt2ADKfTDtyZDKalzMcLnpTnRi
#
# Webhook: keeps the Mongo "users" collection in step with Clerk.
#   1. Clerk dashboard → Webhooks → Add Endpoint
#   2. URL:  https://<your-api-host>/api/webhooks/clerk
#      (locally, expose port 5000 with a tunnel — Clerk cannot reach localhost)
#   3. Subscribe to: user.created, user.updated, user.deleted
#   4. Copy the "Signing Secret" (whsec_…) here.
# Optional: without it, a customer's local record is still created lazily on
# their first authenticated request, but later profile edits and account
# deletions made in Clerk will not propagate.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- where the frontend lives ----
# This is the base of the verification link that gets emailed, and the browser
# origin the API accepts. It must be an address the RECIPIENT can open:
#   local testing on this PC ....... http://localhost:5173
#   phone / another laptop ......... http://<your-lan-ip>:5173   (run vite --host)
#   real users .................... https://your-tunnel-or-domain
CLIENT_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated (keep localhost while testing):
# CORS_ORIGINS=http://localhost:5173,https://your-tunnel-or-domain

# ---- STAFF email verification (Resend, over HTTPS) ----
# Only staff sign-ups (agents/admins) send mail from here. Customer email
# verification belongs to Clerk and does not use this key.
#
# Mail is sent with the Resend REST API, NOT SMTP. That is deliberate: Render (and
# most PaaS free tiers) block outbound ports 25/465/587, so nodemailer/Gmail fails
# there with ETIMEDOUT however correct the credentials are. Port 443 is never blocked.
#
# 1. Sign up at https://resend.com and create a key at https://resend.com/api-keys
#    ("Sending access" is enough). Paste it below.
RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 2. Who the mail comes FROM. Leave it UNSET to use Resend's sandbox sender
#    (onboarding@resend.dev) — no DNS setup, but it only delivers to the address
#    that owns your Resend account, which is fine for a first test.
#    To email real users: add your domain at https://resend.com/domains, publish
#    the DNS records it shows, wait for "Verified", then set this:
# MAIL_FROM=OptiDesk <no-reply@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com   # optional — where replies land
# MAIL_TIMEOUT_MS=10000                  # optional — abort a stalled send
#
# Check it without registering a user:  npm run mail:test you@example.com
# The API also verifies the key at boot and prints ON/OFF with the reason.

# How long an emailed verification link stays usable (any "ms" duration string).
# EMAIL_VERIFY_TTL=24h
# The verification JWT is signed with "<JWT_SECRET>::verify-email" unless you set
# this. Leave it unset unless you want to rotate verification links on their own —
# it must NOT equal JWT_SECRET, or a verification link would double as a session
# token. Changing either value invalidates links already in people's inboxes.
# EMAIL_VERIFY_SECRET=

# ---- admin account ----
# Used by "npm run seed:admin". Change the password before deploying.
ADMIN_NAME=OptiDesk Admin
ADMIN_EMAIL=admin@optidesk.local
ADMIN_PASSWORD=admin123
# Lets someone register an ADMIN account from the staff form when they know this
# code. Leave blank to turn admin self-signup off entirely. Customers cannot use
# it — POST /api/auth/register refuses role "customer" and points at Clerk.
# ADMIN_SIGNUP_CODE=

# ---- AI ----
# https://aistudio.google.com/apikey — needed for the RAG chat assistant only.
# Ticket triage (category/priority/sentiment) works without it.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.6-flash   # override the generation model
# USE_ATLAS_VECTOR=false               # true once an Atlas vector index exists

# ---- legacy, safe to delete ----
# Earlier versions sent mail over SMTP with nodemailer. services/mailer.js now
# uses the Resend HTTPS API, so NONE of these are read any more — delete them,
# and revoke that Gmail app password at myaccount.google.com/apppasswords.
# EMAIL_USER=  EMAIL_PASS=  EMAIL_SERVICE=
# SMTP_USER=   SMTP_PASS=   SMTP_HOST=   SMTP_PORT=   MAIL_FROM_NAME=   API_URL=
